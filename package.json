{
  "name": "altamiuz",
  "version": "0.1.0",
  "private": true,
  "description": "Altamiuz bilingual website and CMS (Next.js + Payload CMS 3)",
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:migrations": "vitest run --project integration tests/integration/migrations",
    "test:smoke": "playwright test --project smoke",
    "test:security": "playwright test --project security",
    "payload": "payload",
    "generate:importmap": "payload generate:importmap",
    "generate:types": "payload generate:types",
    "migrate": "payload migrate",
    "migrate:create": "payload migrate:create",
    "migrate:down": "payload migrate:down",
    "migrate:status": "payload migrate:status",
    "secrets:scan": "sh scripts/gitleaks.sh detect",
    "audit:deps": "pnpm audit --audit-level high && sh scripts/osv-scan.sh",
    "ci:local": "sh scripts/ci-local.sh",
    "prepare": "sh scripts/install-hooks.sh",
    "test:a11y": "playwright test --project a11y-admin --project a11y-public",
    "test:public": "playwright test --project public --project public-webkit",
    "test:e2e": "playwright test --project e2e",
    "perf:lighthouse": "sh scripts/lighthouse.sh",
    "bootstrap:owner": "payload run scripts/bootstrap-owner.ts",
    "scan:richtext": "payload run scripts/scan-richtext.ts",
    "ops:restore-drill": "ops/restore-drill.sh",
    "ops:measure-delivery": "ops/measure/delivery.sh",
    "check:route-vocab": "tsx scripts/check-route-vocab.ts",
    "neon:migrate": "node scripts/with-neon.mjs --direct -- pnpm -s payload migrate",
    "neon:migrate:status": "node scripts/with-neon.mjs --direct -- pnpm -s payload migrate:status",
    "neon:start": "node scripts/with-neon.mjs -- pnpm start"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "@payloadcms/ui": "3.92.1",
    "graphql": "16.14.2",
    "next": "16.4.5",
    "nodemailer": "10.1.7",
    "otplib": "13.5.0",
    "payload": "3.92.1",
    "pg": "8.20.0",
    "pino": "10.4.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.16.0",
    "@neon/config": "1.9.2",
    "@neon/env": "1.6.3",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ],
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-cg2g-xh64-v4q7",
        "GHSA-mrv2-3pqr-j5jr",
        "GHSA-c475-qrg2-pj4r"
      ]
    },
    "overrides": {
      "@lexical/headless>happy-dom": "21.0.4"
    }
  }
}
