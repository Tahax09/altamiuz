# Altamiuz — example environment. PLACEHOLDERS ONLY. Never commit real values.
# Copy to .env.local for development. See specs/001-v1-website-cms/contracts/configuration.md.
# In APP_ENV=production the app refuses to start if any value below is a placeholder,
# missing, or a development substitute.

APP_ENV=development
SITE_URL=http://localhost:3000
LOG_LEVEL=debug

# PostgreSQL (docker-compose.dev.yml)
POSTGRES_DEV_PASSWORD=change-me-local-only
DATABASE_URL=postgres://altamiuz:change-me-local-only@127.0.0.1:54320/altamiuz
# Schema "push" is only for throwaway local databases; never true in preview/production.
DATABASE_ALLOW_PUSH=false

# Secrets (generate locally: openssl rand -hex 32)
PAYLOAD_SECRET=replace-with-32-plus-random-bytes
MFA_ENCRYPTION_KEY=replace-with-64-hex-chars-32-bytes
HEALTH_READY_TOKEN=replace-with-random-token
JOBS_SIGNING_SECRET=replace-with-random-token

# Storage: local | s3
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email: smtp (Mailpit) | memory | resend
EMAIL_DRIVER=smtp
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=no-reply@localhost
RESEND_API_KEY=

# Rate limiting: memory | postgres | upstash
RATELIMIT_DRIVER=postgres
# Client IP source for per-client limits. 0 hops = ignore X-Forwarded-For (local dev).
# Production must set TRUSTED_PROXY_HOPS (proxies appending to X-Forwarded-For) or CLIENT_IP_HEADER.
TRUSTED_PROXY_HOPS=0
CLIENT_IP_HEADER=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Background jobs: local-runner | cron | qstash
JOBS_TRIGGER=local-runner
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Bot challenge: Cloudflare's documented TEST keys are the local default (no network call).
CAPTCHA_DRIVER=test
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Analytics: none | <provider decided in R-F>
ANALYTICS_DRIVER=none

# One-time first-owner bootstrap (Phase 3). Leave empty except for the bootstrap run.
BOOTSTRAP_OWNER_EMAIL=
